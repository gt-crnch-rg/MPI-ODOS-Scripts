+# DOCA >= 3.x: Comch replaces Comm Channel, and the libraries moved from
+# lib64/ to lib/<arch>-linux-gnu/.
+set(additional_libs "")
+foreach(_doca_lib doca_common doca_comch)
+	find_library(${_doca_lib}_LIBRARY ${_doca_lib}
