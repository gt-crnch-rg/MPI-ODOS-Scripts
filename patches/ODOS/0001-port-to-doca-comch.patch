Port the BlueField libomptarget plugin from the DOCA 2.0 Comm Channel API to
DOCA >= 3.0 Comch (Comm Channel was removed in DOCA 3.x).

* send/recv go through odos_comch.h (copied in by apply_patches.sh)
* connecting retries for up to 30 s (ODOS_COMCH_CONNECT_TIMEOUT overrides)
  so a just-started DPU service is not a hard failure
* device filter: DMA job support (DOCA 2.0 API) -> Comch client capability
* PCI address as a string (struct doca_pci_bdf is gone); renamed calls
* CMake: respect -DDOCA_PATH (a plain set() shadowed it); link
  libdoca_comch, found under lib/<arch>-linux-gnu or lib64
* dev_list is zeroed, so deinit of a never-initialised device is a no-op

Against openucx/ODOS (bf) 6b725556ee26f208dd65db9140511fe704047694.

diff --git a/openmp/libomptarget/plugins/bf/CMakeLists.txt b/openmp/libomptarget/plugins/bf/CMakeLists.txt
index 4fbfd77ac..d3d0441df 100644
--- a/openmp/libomptarget/plugins/bf/CMakeLists.txt
+++ b/openmp/libomptarget/plugins/bf/CMakeLists.txt
@@ -14,10 +14,22 @@ set(elf_machine_id 183)
 
 #set(DOCA_PATH "/global/software/centos-8.x86_64/modules/tools/doca/1.5.1/opt/mellanox/doca")
 #/global/software/rocky-9.x86_64/modules/tools/doca/2.0.2/opt/mellanox/doca/lib64
-set(DOCA_PATH "/global/software/rocky-9.x86_64/modules/tools/doca/2.0.2/opt/mellanox/doca")
-set(additional_libs "${DOCA_PATH}/lib64/libdoca_common.so"
-                    "${DOCA_PATH}/lib64/libdoca_dma.so"
-                    "${DOCA_PATH}/lib64/libdoca_comm_channel.so")
+if(NOT DOCA_PATH)
+  set(DOCA_PATH "/global/software/rocky-9.x86_64/modules/tools/doca/2.0.2/opt/mellanox/doca")
+endif()
+# DOCA >= 3.x: Comch replaces Comm Channel, and the libraries moved from
+# lib64/ to lib/<arch>-linux-gnu/.
+set(additional_libs "")
+foreach(_doca_lib doca_common doca_comch)
+	find_library(${_doca_lib}_LIBRARY ${_doca_lib}
+		HINTS "${DOCA_PATH}/lib/${CMAKE_SYSTEM_PROCESSOR}-linux-gnu" "${DOCA_PATH}/lib64"
+		NO_DEFAULT_PATH)
+	if(NOT ${_doca_lib}_LIBRARY)
+		message(FATAL_ERROR "${_doca_lib} not found under ${DOCA_PATH} (DOCA >= 3.0 required)")
+	endif()
+	list(APPEND additional_libs "${${_doca_lib}_LIBRARY}")
+endforeach()
+add_definitions(-DDOCA_ALLOW_EXPERIMENTAL_API)
 
 add_definitions(-w)
 # Define macro to be used as prefix of the runtime messages for this target.
