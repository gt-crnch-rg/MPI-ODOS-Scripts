# syntax=docker/dockerfile:1
#
# Two-stage build:
#   * builder stage compiles UCX/ODOS/Open MPI/PnetCDF
#   * runtime stage carries only install artifacts and runtime libs
#
# DOCA is provided from an external build context named doca.
# Example:
#   export HOST_DOCA_PATH=/opt/mellanox/doca
#   docker buildx build --build-context doca="${HOST_DOCA_PATH}" -t odos-mpi .

ARG DEBIAN_FRONTEND=noninteractive
ARG DOCA_PATH=/opt/mellanox/doca
ARG ROCKY_DOCA=/global/software/rocky-9.x86_64/modules/tools/doca/2.0.2/opt/mellanox/doca
ARG ROCKY_CMAKE=/global/software/rocky-9.x86_64/modules/tools/cmake/3.26.4/bin/cmake

FROM ubuntu:22.04 AS builder

ARG DEBIAN_FRONTEND
ARG DOCA_PATH
ARG ROCKY_DOCA
ARG ROCKY_CMAKE

ENV APP_ROOT=/opt/odos-mpi
ENV DOCA_PATH=${DOCA_PATH}

# Build dependencies only in builder stage.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ make \
        autoconf automake libtool libtool-bin m4 \
        flex bison perl \
        git wget curl ca-certificates gnupg \
        python3 python3-dev python3-pip \
        pkg-config \
        zlib1g-dev libnuma-dev libffi-dev libelf-dev \
        libibverbs-dev librdmacm-dev rdma-core \
    && rm -rf /var/lib/apt/lists/*

RUN wget -qO- https://apt.kitware.com/keys/kitware-archive-latest.asc \
        | gpg --dearmor -o /usr/share/keyrings/kitware-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/kitware-archive-keyring.gpg] https://apt.kitware.com/ubuntu/ jammy main" \
        > /etc/apt/sources.list.d/kitware.list \
    && apt-get update && apt-get install -y --no-install-recommends cmake \
    && rm -rf /var/lib/apt/lists/*

RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/module \
    && chmod +x /usr/local/bin/module

COPY --from=doca . ${DOCA_PATH}/

RUN mkdir -p "$(dirname "$ROCKY_DOCA")" "$(dirname "$ROCKY_CMAKE")" \
    && ln -sfn "$DOCA_PATH" "$ROCKY_DOCA" \
    && ln -sf "$(command -v cmake)" "$ROCKY_CMAKE" \
    && test -d "$DOCA_PATH" \
    && if [ -d "$DOCA_PATH/lib/x86_64-linux-gnu" ] && [ ! -e "$DOCA_PATH/lib64" ]; then \
           ln -sfn lib/x86_64-linux-gnu "$DOCA_PATH/lib64"; \
       fi

WORKDIR ${APP_ROOT}
COPY . ${APP_ROOT}/

RUN bash install_odos_prereqs.sh

ENV PATH=${APP_ROOT}/build/ompi/x86_64/install/bin:${APP_ROOT}/build/odos/install/bin:${PATH}
ENV LD_LIBRARY_PATH=${APP_ROOT}/build/ompi/x86_64/install/lib:${APP_ROOT}/build/ucx/x86_64/install/lib:${APP_ROOT}/build/odos/install/lib:${DOCA_PATH}/lib64:${LD_LIBRARY_PATH}
ENV OPAL_PREFIX=${APP_ROOT}/build/ompi/x86_64/install

RUN sh setup.sh
RUN sh compile_1_ucx.sh ./build/ucx/x86_64
RUN sh compile_2_odos.sh \
        "$(pwd)/repos/ODOS" \
        "$(pwd)/build/odos/build" \
        "$(pwd)/build/odos/install"
RUN sh compile_3_ompi.sh \
        ./build/ompi/x86_64 \
        "$(pwd)/build/ucx/x86_64/install" \
        "$ROCKY_DOCA" \
        "$ROCKY_CMAKE"
RUN sh compile_4_pnetcdf.sh ./build/pnetcdf

FROM ubuntu:22.04

ARG DEBIAN_FRONTEND
ARG DOCA_PATH
ARG ROCKY_DOCA
ARG ROCKY_CMAKE

ENV APP_ROOT=/opt/odos-mpi
ENV DOCA_PATH=${DOCA_PATH}

# Runtime dependencies only.
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates \
        libnuma1 libffi8 libelf1 \
        libibverbs1 librdmacm1 rdma-core \
    && rm -rf /var/lib/apt/lists/*

RUN printf '#!/bin/sh\nexit 0\n' > /usr/local/bin/module \
    && chmod +x /usr/local/bin/module

COPY --from=builder ${DOCA_PATH}/ ${DOCA_PATH}/

RUN mkdir -p "$(dirname "$ROCKY_DOCA")" "$(dirname "$ROCKY_CMAKE")" \
    && ln -sfn "$DOCA_PATH" "$ROCKY_DOCA" \
    && if [ -d "$DOCA_PATH/lib/x86_64-linux-gnu" ] && [ ! -e "$DOCA_PATH/lib64" ]; then \
           ln -sfn lib/x86_64-linux-gnu "$DOCA_PATH/lib64"; \
       fi

WORKDIR ${APP_ROOT}
COPY . ${APP_ROOT}/

# Copy only built install artifacts from the builder stage.
COPY --from=builder ${APP_ROOT}/build/ucx/x86_64/install ${APP_ROOT}/build/ucx/x86_64/install
COPY --from=builder ${APP_ROOT}/build/odos/install ${APP_ROOT}/build/odos/install
COPY --from=builder ${APP_ROOT}/build/ompi/x86_64/install ${APP_ROOT}/build/ompi/x86_64/install
COPY --from=builder ${APP_ROOT}/build/pnetcdf/install ${APP_ROOT}/build/pnetcdf/install

ENV PATH=${APP_ROOT}/build/ompi/x86_64/install/bin:${APP_ROOT}/build/odos/install/bin:${PATH}
ENV LD_LIBRARY_PATH=${APP_ROOT}/build/ompi/x86_64/install/lib:${APP_ROOT}/build/ucx/x86_64/install/lib:${APP_ROOT}/build/odos/install/lib:${APP_ROOT}/build/pnetcdf/install/lib:${DOCA_PATH}/lib64:${LD_LIBRARY_PATH}
ENV OPAL_PREFIX=${APP_ROOT}/build/ompi/x86_64/install

CMD ["/bin/bash"]
